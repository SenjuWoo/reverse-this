  "retired": [
    {
      "id": "assetstudio",
      "instead": "assetripper",
      "why": "The AssetStudio repository is archived."
    },
    {
      "id": "dnspy",
      "instead": "dnspyex",
      "why": "The original dnSpy repository is archived."
    },
    {
      "id": "uabe",
      "instead": "uabea",
      "why": "Original UABE is unsupported. UABEA is the build that still publishes a Windows zip."
    },
    {
      "id": "umodel-ue4",
      "instead": "fmodel",
      "why": "UE Viewer/UModel supports older Unreal and many UE4 games. Keep it as a target-specific manual route; FModel, repak and retoc are the default modern Unreal toolset here."
    },
    {
      "id": "cpp2il-2022-binary",
      "instead": "il2cppdumper",
      "why": "Cpp2IL's latest stable binary is 2022.0.7, but active preview binaries are published. Keep Il2CppDumper as this kit's default and use the documented target-specific Cpp2IL preview route when needed."
    },
    {
      "id": "ue4ss-stable",
      "instead": "ue4ss",
      "why": "The stable UE4SS tag lags the experimental release. The kit installs experimental-latest."
    },
    {
      "id": "bepinex6-pre2",
      "instead": "melonloader",
      "why": "BepInEx 6.0.0-pre.2 is an old prerelease. Mono games get current BepInEx 5. IL2CPP gets current MelonLoader."
    },
    {
      "id": "cheat-engine-download",
      "instead": null,
      "why": "The Cheat Engine GitHub release ships no binary. The kit does not download the bundled website installer."
    },
    {
      "id": "reclass-rar",
      "instead": null,
      "why": "ReClass.NET's only published binary is the 2019 v1.2 rar. The source kept changing through 2024 and published no newer binary."
    },
    {
      "id": "3dmigoto-tag",
      "instead": null,
      "why": "The tagged 3Dmigoto release is from 2018, the repository has continued, and that release attaches every historical zip so one pattern cannot select a current file."
    },
    {
      "id": "sinai-unityexplorer",
      "instead": "unityexplorer-bepinex5",
      "why": "sinai-dev/UnityExplorer is archived. The kit uses the yukieiji fork."
    },
    {
      "id": "frosty-rewrite",
      "instead": "frosty-editor",
      "why": "FrostyToolsuite/FrostyToolsuite publishes no release. The kit installs the stable Editor and Mod Manager zips."
    },
    {
      "id": "ldtk-installer",
      "instead": "ldtk",
      "why": "LDtk's Windows file is an installer. The kit unpacks it with 7-Zip and does not run it."
    },
    {
      "id": "openbor-rar",
      "instead": "openbor",
      "why": "OpenBOR's Windows file is a rar. The kit unpacks it with 7-Zip."
    },
    {
      "id": "fighter-factory-installer",
      "instead": "fighter-factory",
      "why": "The old dump only had an installer. The kit downloads the official Windows portable zip."
    }
